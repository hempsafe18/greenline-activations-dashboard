# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Clerk Authentication (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Google Sheets API Configuration (Required for activation requests)
# JSON stringified Google service account credentials with spreadsheets scope
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account",...}

# Optional: Google Sheets Spreadsheet IDs (defaults provided in code)
AMIGOS_SPREADSHEET_ID=
THREE_CHI_SPREADSHEET_ID=
MELLOW_FELLOW_SPREADSHEET_ID=
GROW_SPREADSHEET_ID=

# Cloudinary (Required for /profiles ambassador headshots)
# Cloud name only — headshot_url values stored in Supabase are full Cloudinary
# delivery URLs, so no API secret is needed for read-only rendering.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=activation

# Cloudinary (Required for Market Intel photo delivery + the recurring sync
# cron at /api/cron/cloudinary-sync). Same cloud as above, server-side name.
CLOUDINARY_CLOUD_NAME=activation
# Only needed by the sync cron — it actively uploads new recap photos into
# Cloudinary's greenline/ folders instead of waiting for someone to view a
# gallery. Get these from Cloudinary Console > Settings > API Keys.
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional override for the auto-upload-mapping folder (defaults to "greenline")
CLOUDINARY_MAPPING_FOLDER=greenline

# Required to authorize Vercel Cron invocations of /api/cron/cloudinary-sync.
# Set this to a random secret in Vercel env vars — Vercel automatically sends
# it as `Authorization: Bearer $CRON_SECRET` on cron-triggered requests.
CRON_SECRET=your-random-cron-secret
